<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8.0 / API 26+): the OS composites this
     foreground over the background and applies its own mask shape
     (circle, squircle, rounded square, ...) per device/launcher. Pre-26
     devices fall back to the legacy mipmap-*/ic_launcher.png files. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
