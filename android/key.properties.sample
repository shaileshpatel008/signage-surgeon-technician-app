# Copy this file to android/key.properties (gitignored) and fill in real
# values once you've generated an upload keystore:
#
#   keytool -genkey -v -keystore ~/signage-surgeon-technician-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Never commit key.properties or the .jks file itself — both are in
# .gitignore already. Store the keystore and these passwords in your
# team's password manager, not in the repo.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/signage-surgeon-technician-upload.jks
